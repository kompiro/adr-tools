{
  "name": "@kompiro/adr-tools",
  "version": "0.0.12",
  "description": "Frontmatter-driven ADR (Architecture Decision Record) validator, extractor, regenerator, and visualizer.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "Hiroki Kondo <kompiro@gmail.com>",
  "homepage": "https://github.com/kompiro/adr-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kompiro/adr-tools.git"
  },
  "bugs": {
    "url": "https://github.com/kompiro/adr-tools/issues"
  },
  "keywords": [
    "adr",
    "architecture-decision-record",
    "documentation",
    "frontmatter"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.schema.json": "./dist/config.schema.json"
  },
  "bin": {
    "adr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:bin": "bash scripts/build-binaries.sh",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "typecheck": "tsc --noEmit",
    "validate:adr": "node dist/cli.js validate"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@karasu-tools/core": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@karasu-tools/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@karasu-tools/core": "^0.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
